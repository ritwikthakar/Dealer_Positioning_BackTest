index 0000000..222f8f6
--- /dev/null
+++ b/test_gamma_screener.py
@@ -0,0 +1,85 @@
+"""Tests for gamma_screener.py and gamma_tab.py (stand-in streamlit, fake chain loader; no network)."""
+import os, sys, types
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import numpy as np, pandas as pd
+import gamma_screener as gs
+
+# ---- gamma sanity: ATM gamma ~ 1/(S*sigma*sqrt(T)) * 0.3989, symmetric in log-moneyness
+g = gs.bs_gamma(100, 100, 30 / 365, 0.2)
+assert abs(g - 0.3989 / (100 * 0.2 * np.sqrt(30 / 365))) / g < 0.02
+assert gs.bs_gamma(100, 150, 30 / 365, 0.2) < g * 1e-3
+
+def chain(call_oi, put_oi, spot=100.0):
+    rows = []
+    for k in range(80, 121, 2):
+        for dte in (5, 20):
+            rows.append((k, "C", call_oi * (1 if k >= spot else 0.4), 0.25, dte, 100))
+            rows.append((k, "P", put_oi * (1 if k <= spot else 0.4), 0.25, dte, 100))
+    return pd.DataFrame(rows, columns=["strike", "cp", "oi", "iv", "dte", "volume"])
+
+# ---- signs: call-heavy positive, put-heavy negative
+r1, t1 = gs.scan_chain("POS", 100.0, chain(5000, 500), 5e9)
+r2, t2 = gs.scan_chain("NEG", 100.0, chain(500, 5000), 5e9)
+assert r1["net_gex_m"] > 0 and r1["regime"] in ("Positive", "Near flip")
+assert r2["net_gex_m"] < 0 and r2["regime"] == "Negative" and r2["gex_pct_adv"] < 0
+assert abs(t1["net"].sum() / 1e6 - r1["net_gex_m"]) < 0.01
+assert r1["call_wall"] >= 100 and r2["put_wall"] <= 100
+
+# ---- flip: puts below, calls above gives a crossing near spot when OI is balanced across the sides
+c = chain(3000, 3000)
+f = gs.zero_gamma(gs.clean_chain(c, 100.0), 100.0)
+assert f is None or 85 <= f <= 115
+
+# ---- filters: zero IV and zero OI rows are dropped; all-bad chain raises
+bad = chain(1000, 1000); bad["iv"] = 0.0
+try: gs.scan_chain("X", 100.0, bad); raise SystemExit("expected ValueError")
+except ValueError: pass
+
+# ---- run(): failures isolated, sorted most negative first
+def loader(t, max_dte):
+    if t == "BOOM": raise RuntimeError("no data")
+    return 100.0, 5e9, chain(500, 5000) if t == "NEG" else chain(5000, 500)
+res, strikes, failed = gs.run(["POS", "NEG", "BOOM"], loader=loader, workers=2)
+assert list(res["ticker"]) == ["NEG", "POS"] and "BOOM" in failed and set(strikes) == {"POS", "NEG"}
+print("gamma_screener ok")
+
+# ---- tab with stand-in streamlit
+LOG = {"errors": [], "infos": [], "frames": [], "charts": 0, "metrics": {}}
+OV = {}
+class Ctx:
+    def __enter__(self): return self
+    def __exit__(self, *a): return False
+    def __getattr__(self, n): return getattr(st, n)
